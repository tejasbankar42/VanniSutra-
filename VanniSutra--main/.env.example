# ==============================================================================
# VocalLens AI - Environment Configuration Template
# Copy this file to .env and fill in your private API keys.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# AI Speech & LLM API Keys (Server-Side Only - Never Exposed to Frontend)
# Gemini API Key for Multimodal Visual & TTS analysis: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for Fast Whisper Speech-to-Text: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Storage Paths
STORAGE_DIR=storage
DATASET_DIR=dataset

# Public Domain / Canonical URL for SEO & Open Graph
VITE_SITE_URL=https://vocallens.ai

# Optional Privacy-Preserving Analytics (e.g., Plausible / Umami ID)
# Leave blank to disable optional tracking
VITE_ANALYTICS_ID=